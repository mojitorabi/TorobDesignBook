{
  "$description": "Semantic tokens, light mode. THIS is the layer product code consumes.",
  "$mode": "light",
  "bg": {
    "$type": "color",
    "canvas": {
      "$value": "{color.sky.100}",
      "$description": "Page background. Was: Background Bright - Light"
    },
    "fog": {
      "$value": "{color.white}",
      "$description": "Raised card / sheet ground. Was: Background Fog - Light"
    },
    "sunken": {
      "$value": "{color.sky.50}"
    },
    "subtle": {
      "$value": "{color.sky.100}",
      "$description": "Zebra rows, spec table even cells"
    },
    "inverse": {
      "$value": "{color.sky.800}"
    },
    "scrim": {
      "$value": "rgba(30, 41, 59, 0.48)",
      "$description": "Behind modals and sheets"
    }
  },
  "fg": {
    "$type": "color",
    "default": {
      "$value": "{color.sky.800}",
      "$description": "Was: Sky 800 - Light / text style 'main'"
    },
    "secondary": {
      "$value": "{color.sky.600}",
      "$description": "Was: 'sec'. Uses Sky 600 rather than Sky 500 — see primitive note."
    },
    "disabled": {
      "$value": "{color.sky.300}",
      "$description": "Was: 'disable'"
    },
    "inverse": {
      "$value": "{color.sky.50}",
      "$description": "Was: 'reverse'"
    },
    "brand": {
      "$value": "{color.red.600}",
      "$description": "Brand red for text. Fills use {color.brand.red}."
    },
    "link": {
      "$value": "{color.blue.500}"
    },
    "on-solid": {
      "$value": "{color.white}",
      "$description": "Text on a filled action surface"
    }
  },
  "border": {
    "$type": "color",
    "subtle": {
      "$value": "{color.sky.100}"
    },
    "default": {
      "$value": "{color.sky.300}"
    },
    "control": {
      "$value": "{color.sky.500}",
      "$description": "Form-control boundary. WCAG 1.4.11 requires 3:1 — border.default is decorative only and does not meet it."
    },
    "strong": {
      "$value": "{color.sky.500}"
    },
    "selected": {
      "$value": "{color.blue.500}",
      "$description": "[NEW] Selection ring. Source used Blue 300 in both modes; on light it measures 2.54:1. Blue 500 keeps the blue language and passes at 4.79:1."
    },
    "focus": {
      "$value": "{color.blue.500}",
      "$description": "Keyboard focus ring"
    }
  },
  "action": {
    "$type": "color",
    "$description": "Three colour families. RED is an online commerce action, BLUE an offline or store action, BLACK a neutral one. Intent aliases (primary/accent/neutral) point at the same values.",
    "red": {
      "$description": "خرید اینترنتی — online commerce. One per screen.",
      "bg-gradient": {
        "$value": "linear-gradient(180deg, {color.red.300} 0%, {color.brand.red} 100%)"
      },
      "bg": {
        "$value": "{color.brand.red}"
      },
      "bg-hover": {
        "$value": "{color.brand.red}",
        "$description": "Hover drops the gradient for the flat brand red."
      },
      "bg-active": {
        "$value": "{color.red.800}"
      },
      "border": {
        "$value": "{color.red.50}",
        "$description": "1px inside rim. The signature edge on every filled Torob button."
      },
      "fg": {
        "$value": "{color.white}"
      },
      "outline-fg": {
        "$value": "{color.red.600}"
      },
      "outline-border": {
        "$value": "{color.brand.red}"
      },
      "ghost-fg": {
        "$value": "{color.red.600}"
      }
    },
    "blue": {
      "$description": "مسیریابی · تماس — offline, store and contact actions.",
      "bg-gradient": {
        "$value": "linear-gradient(180deg, {color.blue.600} 0%, {color.blue.500} 100%)"
      },
      "bg": {
        "$value": "{color.blue.500}"
      },
      "bg-hover": {
        "$value": "{color.blue.500}"
      },
      "bg-active": {
        "$value": "{color.blue.800}"
      },
      "border": {
        "$value": "{color.blue.300}",
        "$description": "1px inside rim."
      },
      "fg": {
        "$value": "{color.white}"
      },
      "outline-fg": {
        "$value": "{color.blue.500}"
      },
      "outline-border": {
        "$value": "{color.blue.500}"
      },
      "ghost-fg": {
        "$value": "{color.blue.500}"
      },
      "soft-bg": {
        "$value": "{color.blue.50}"
      },
      "soft-fg": {
        "$value": "{color.blue.800}"
      }
    },
    "black": {
      "$description": "Neutral. Runs on the legacy Ink ramp, not on Sky.",
      "bg": {
        "$value": "{color.ink.80}"
      },
      "bg-hover": {
        "$value": "{color.ink.60}"
      },
      "bg-active": {
        "$value": "{color.sky.900}"
      },
      "fg": {
        "$value": "{color.white}"
      },
      "ghost-fg": {
        "$value": "{color.ink.80}"
      },
      "ghost-border": {
        "$value": "{color.ink.80}"
      },
      "ghost-border-hover": {
        "$value": "{color.ink.40}"
      },
      "ghost-bg-hover": {
        "$value": "{color.sky.100}"
      }
    },
    "disabled": {
      "$description": "One disabled treatment. Every family collapses to it — a disabled control must not still read as primary.",
      "bg": {
        "$value": "{color.grey.disabled}"
      },
      "fg": {
        "$value": "{color.ink.55}"
      }
    }
  },
